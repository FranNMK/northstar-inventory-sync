# Copy to .env and fill in your values
DATABASE_URL=mysql+pymysql://root:password@localhost:4000/northstar_inventory
WEBHOOK_SECRET=change-me-to-a-strong-random-secret

# Authentication
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS — set to your deployed frontend URL on Render (leave blank for local dev)
# FRONTEND_URL=https://northstar-inventory-sync-frontend.onrender.com
